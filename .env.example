# ==============================================================================
# trysomenew - Environment Variables Configuration
# ==============================================================================

# Frontend (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend (apps/api)
PROJECT_NAME=trysomenew
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
MAX_UPLOAD_SIZE_BYTES=104857600
CORS_ORIGINS=["http://localhost:3000","https://trysomenew.com"]

# Databases & Caching
DATABASE_URL=postgresql://trysomenew:trysomenew_secret@localhost:5432/trysomenew
REDIS_URL=redis://localhost:6379/0
